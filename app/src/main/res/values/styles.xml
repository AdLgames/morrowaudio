<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#596B55</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F5F0</item>
        <item name="android:navigationBarColor">#F7F5F0</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F5F0</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AppThemeBlue" parent="AppTheme"><item name="android:colorAccent">#526B7A</item></style>
    <style name="AppThemeRose" parent="AppTheme"><item name="android:colorAccent">#8A5F55</item></style>
    <style name="AppThemeLavender" parent="AppTheme"><item name="android:colorAccent">#71627F</item></style>
    <style name="AppThemeCocoa" parent="AppTheme"><item name="android:colorAccent">#77634F</item></style>
</resources>
