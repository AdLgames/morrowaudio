{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morrow-ai-trial",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "vars": { "OPENAI_MODEL": "gpt-6.1-sol", "AI_DAILY_LIMIT": "20", "CHAPTER_DAILY_LIMIT": "25" },
  "durable_objects": { "bindings": [{ "name": "TRIAL_BUDGET", "class_name": "TrialBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrialBudget"] }],
  "observability": { "enabled": false }
}
